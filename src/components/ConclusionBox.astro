---
/**
 * 結論ボックス（design-spec-v2.md §2）
 *
 * 記事タイトル・著者情報の直下に置く。読者が3秒で判断できることを狙う。
 * 呼び出しは記事の frontmatter 経由（ArticleLayout.astro が描画する）。
 *
 *   conclusion:
 *     - "鉄1mgあたりのコストで比べると「DHC ヘム鉄 徳用90日分」が最も低い"
 *     - "1日あたりのコストで比べると「ネイチャーメイド 鉄」が最も低い"
 *
 * 中身のルール（§2）は書き手側の責任。
 *   - 3〜5項目、各項目は1行に収める
 *   - 製品名は「」で囲む
 *   - 「最も安い」等の無条件の断定を避け、比較の基準を必ず添える
 */

import AffiliateCTA from './AffiliateCTA.astro';
import InlineText from './InlineText.astro';

/** v3：結論に並べる推薦（products[] から渡される） */
export interface ConclusionRecommendation {
  direction?: string;
  name: string;
  keyPoint?: string;
  /** 販売ページへの導線。運営者が付与する。未指定ならCTAを出さない */
  affiliateUrl?: string;
  affiliateLabel?: string;
  affiliateProvider?: string;
}

interface Props {
  /** legacy：箇条書きにする結論。空・未指定なら何も描画しない */
  items?: string[];
  /** v3：Issue 1 への短い回答（conclusion.issue1） */
  issue1?: string;
  /** v3：Issue 2 の推薦一覧（products[] から生成） */
  recommendations?: ConclusionRecommendation[];
  /** 見出し文言。通常は変えない */
  heading?: string;
}

const {
  items = [],
  issue1,
  recommendations = [],
  heading = 'この記事の結論',
} = Astro.props;

// frontmatter に conclusion を持たない既存記事では、丸ごと出力しない
const hasItems = Array.isArray(items) && items.length > 0;

// v3：issue1 があれば v3 描画。legacy（items）には一切影響しない
const issue1Text = typeof issue1 === 'string' ? issue1.trim() : '';
const recs = Array.isArray(recommendations)
  ? recommendations.filter((r) => r && typeof r.name === 'string' && r.name.trim() !== '')
  : [];
const isV3 = issue1Text !== '' || recs.length > 0;
---

{isV3 && (
  <aside class="conclusion-box" aria-label={heading}>
    <p class="conclusion-heading">
      <svg
        class="conclusion-heading-icon"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="10" cy="10" r="9" fill="currentColor" />
        <path
          d="M5.8 10.3l2.7 2.7 5.7-5.7"
          fill="none"
          stroke="#ffffff"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>{heading}</span>
    </p>

    {issue1Text && <p class="conclusion-issue1"><InlineText text={issue1Text} /></p>}

    {recs.length > 0 && (
      <ul class="conclusion-recs">
        {recs.map((rec) => (
          <li>
            {rec.direction && <span class="conclusion-rec-direction">{rec.direction}なら</span>}
            <span class="conclusion-rec-name">{rec.name}</span>
            {rec.keyPoint && <span class="conclusion-rec-key">{rec.keyPoint}</span>}
            {rec.affiliateUrl && (
              <span class="conclusion-rec-cta">
                <AffiliateCTA
                  url={rec.affiliateUrl}
                  label={rec.affiliateLabel}
                  provider={rec.affiliateProvider}
                  variant="compact"
                  ariaLabel={`${rec.name}｜${(rec.affiliateLabel ?? "").trim() || "販売ページを見る"}（外部サイト）`}
                />
              </span>
            )}
          </li>
        ))}
      </ul>
    )}
  </aside>
)}

{hasItems && (
  <aside class="conclusion-box" aria-label={heading}>
    <p class="conclusion-heading">
      <svg
        class="conclusion-heading-icon"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="10" cy="10" r="9" fill="currentColor" />
        <path
          d="M5.8 10.3l2.7 2.7 5.7-5.7"
          fill="none"
          stroke="#ffffff"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>{heading}</span>
    </p>

    <ul class="conclusion-list">
      {items.map((item) => (
        <li>
          <svg
            class="conclusion-item-icon"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M2.5 8.6l3.4 3.4L13.5 4.4"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  /* 色は global.css の :root 変数だけを使う。生の色コードは書かない。
     白地の上に浮く白カード。面を塗らず、border と影で「まとまり」を作る */
  .conclusion-box {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 1.8rem 1.6rem 1.6rem;
    margin: 0 0 3.4rem;
  }

  /* 見出しはピル型のラベル。最初に「これが結論」と分かることだけを担う */
  .conclusion-heading {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--color-primary);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.6;
    color: #fff;
  }

  /* ピルの中ではアイコンは意味を持たないため出さない（markup は据え置き） */
  .conclusion-heading-icon {
    display: none;
  }

  .conclusion-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .conclusion-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 0.65rem;
    line-height: 1.75;
  }

  .conclusion-list li:last-child {
    margin-bottom: 0;
  }

  .conclusion-item-icon {
    flex: none;
    width: 1em;
    height: 1em;
    /* 行の1文字目と高さを揃える。line-height 1.75 の中央あたりに置く */
    margin-top: 0.42em;
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .conclusion-box {
      padding: 1.25rem 1.1rem;
      margin-bottom: 2rem;
    }

    .conclusion-heading {
      font-size: 1rem;
    }

    .conclusion-list li {
      font-size: 0.95rem;
    }
  }
</style>

<style>
  /* v3：Issue 1 の回答 → Issue 2 の推薦、の順で見せる */
  .conclusion-issue1 {
    margin: 0 0 1.2rem;
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.95;
    color: var(--color-primary-dark);
  }

  /* 重要語は色を変えず、淡いベージュの下線で持ち上げる */
  .conclusion-issue1 :global(strong) {
    padding: 0 0.15rem;
    background: linear-gradient(transparent 62%, var(--color-sand) 62%);
    font-weight: 800;
  }

  .conclusion-recs {
    margin: 0;
    padding: 1.1rem 0 0;
    border-top: 1px dashed var(--color-border);
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .conclusion-recs li {
    display: grid;
    grid-template-columns: 11em 1fr;
    gap: 0.15rem 0.75rem;
    align-items: baseline;
    padding: 0.75rem 0.95rem;
    border: 1px solid var(--color-border-soft);
    border-radius: var(--radius-md);
    background: var(--color-bg);
    line-height: 1.7;
  }

  .conclusion-rec-direction {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .conclusion-rec-name {
    font-weight: 700;
  }

  .conclusion-rec-key {
    grid-column: 2;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* 一言特徴の下に置く小さめの導線。行の高さを崩さないよう上に少し余白を取る */
  .conclusion-rec-cta {
    grid-column: 2;
    margin-top: 0.35rem;
  }

  @media (max-width: 640px) {
    .conclusion-recs li {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }

    .conclusion-rec-key,
    .conclusion-rec-cta {
      grid-column: 1;
    }
  }
</style>

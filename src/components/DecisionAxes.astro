---
/**
 * 選び方の軸（v2 記事順序の 3 番目）
 *
 * カテゴリ検討ブロックの直下、タイプ別候補（TypeGuide）の上に置く。
 * 「何を見て選ぶか」を 2〜3 枚のカードで示す。商品名はここに出さない。
 *
 *   decisionAxes:
 *     - title: "毎月の出費"
 *       description: "同じ日数に揃えたときの価格で比べます。"
 *       metric: "30日換算価格"
 *     - title: "1日に飲む粒数"
 *       description: "続けやすさに直結します。"
 *       metric: "1日の目安量"
 *
 * ラベルに書くのは「選び方の軸」であって、読者の属性ではない。
 * この判断は書き手側の責任で、コンポーネントは検査しない。
 *
 * frontmatter に decisionAxes を持たない既存記事では、丸ごと出力しない。
 */

export interface DecisionAxisItem {
  /** 軸の名前。短く */
  title: string;
  /** なぜその軸を見るのか。1〜2行 */
  description: string;
  /** その軸を測る指標名。省略可 */
  metric?: string;
}

interface Props {
  /** 記事 frontmatter の decisionAxes。空・未指定なら何も描画しない */
  items?: DecisionAxisItem[];
  /** 見出し文言。通常は変えない */
  heading?: string;
}

const { items = [], heading = 'この記事での選び方' } = Astro.props;

const axes = Array.isArray(items)
  ? items.filter((item) => item && typeof item.title === 'string' && item.title.trim() !== '')
  : [];

const hasItems = axes.length > 0;

// 2〜3枚を想定。4枚以上渡されても列は3で止め、折り返して並べる
const columns = Math.min(axes.length || 1, 3);
---

{hasItems && (
  <section class="decision-axes" aria-label={heading} style={`--decision-axes-columns:${columns}`}>
    <p class="decision-axes-heading">{heading}</p>

    <ol class="decision-axes-list">
      {axes.map((item, index) => (
        <li class="decision-axes-card">
          <span class="decision-axes-index" aria-hidden="true">{index + 1}</span>

          <p class="decision-axes-title">{item.title}</p>

          {item.description && (
            <p class="decision-axes-description">{item.description}</p>
          )}

          {item.metric && <p class="decision-axes-metric">{item.metric}</p>}
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  /* 色は global.css の :root 変数をそのまま使う。生の色コードは書かない */
  .decision-axes {
    margin: 0 0 2.5rem;
  }

  .decision-axes-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.9rem;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-text);
  }

  /* 見出しの前に短い罫を置いて、本文の h2 とは別の階層だと分かるようにする */
  .decision-axes-heading::before {
    content: '';
    flex: none;
    width: 1.1rem;
    height: 3px;
    border-radius: 2px;
    background: var(--color-primary);
  }

  .decision-axes-list {
    display: grid;
    grid-template-columns: repeat(var(--decision-axes-columns, 3), minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .decision-axes-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    margin: 0;
    padding: 1.1rem 1rem 1rem;
    background: var(--color-bg-subtle);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-primary);
    border-radius: 8px;
  }

  /* 軸の番号。読む順序があることを示す */
  .decision-axes-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    margin-bottom: 0.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: var(--color-bg);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .decision-axes-title {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-text);
  }

  .decision-axes-description {
    margin: 0 0 0.7rem;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--color-text-muted);
  }

  /* 指標名。カード下端に揃える */
  .decision-axes-metric {
    margin: auto 0 0;
    padding-top: 0.5rem;
    border-top: 1px dashed var(--color-border);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-primary-dark);
  }

  /* スマホ：1列に縦積み（軸の説明は文字量があるため、2列にしない） */
  @media (max-width: 640px) {
    .decision-axes {
      margin-bottom: 2rem;
    }

    .decision-axes-heading {
      font-size: 1rem;
    }

    .decision-axes-list {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.7rem;
    }

    .decision-axes-card {
      padding: 0.95rem 0.9rem 0.9rem;
    }

    .decision-axes-description {
      margin-bottom: 0.55rem;
      font-size: 0.85rem;
    }
  }
</style>

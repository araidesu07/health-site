/** 医薬品／医薬部外品の比較。左右のカードで同じ4項目を並べる（列に強弱を付けない） */
const compareAxes = ['制度上の区分', '効能・効果の文言', '販売時の手続き', '対象者の限定'];
const compareSides = [
  {
    tag: '今回紹介する4商品',
    name: 'ミノキシジル5%の外用発毛剤',
    kind: '第1類医薬品',

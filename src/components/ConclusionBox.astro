---
/**
 * 結論ボックス（design-spec-v2.md §2）
 *
 * 記事タイトル・著者情報の直下に置く。読者が3秒で判断できることを狙う。
 * 呼び出しは記事の frontmatter 経由（ArticleLayout.astro が描画する）。
 *
 *   conclusion:
 *     - "鉄1mgあたりのコストで比べると「DHC ヘム鉄 徳用90日分」が最も低い"
 *     - "1日あたりのコストで比べると「ネイチャーメイド 鉄」が最も低い"
 *
 * 中身のルール（§2）は書き手側の責任。
 *   - 3〜5項目、各項目は1行に収める
 *   - 製品名は「」で囲む
 *   - 「最も安い」等の無条件の断定を避け、比較の基準を必ず添える
 */

interface Props {
  /** 箇条書きにする結論。空・未指定なら何も描画しない */
  items?: string[];
  /** 見出し文言。通常は変えない */
  heading?: string;
}

const { items = [], heading = 'この記事の結論' } = Astro.props;

// frontmatter に conclusion を持たない既存記事では、丸ごと出力しない
const hasItems = Array.isArray(items) && items.length > 0;
---

{hasItems && (
  <aside class="conclusion-box" aria-label={heading}>
    <p class="conclusion-heading">
      <svg
        class="conclusion-heading-icon"
        viewBox="0 0 20 20"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="10" cy="10" r="9" fill="currentColor" />
        <path
          d="M5.8 10.3l2.7 2.7 5.7-5.7"
          fill="none"
          stroke="#ffffff"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span>{heading}</span>
    </p>

    <ul class="conclusion-list">
      {items.map((item) => (
        <li>
          <svg
            class="conclusion-item-icon"
            viewBox="0 0 16 16"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M2.5 8.6l3.4 3.4L13.5 4.4"
              fill="none"
              stroke="currentColor"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  /* design-spec.md の CSS 変数（:root）をそのまま使う。生の色コードは書かない */
  .conclusion-box {
    background: var(--color-accent-light);
    border-left: 4px solid var(--color-accent);
    border-radius: 6px;
    padding: 1.5rem;
    margin: 0 0 2.5rem;
  }

  .conclusion-heading {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.5;
    color: var(--color-text);
  }

  .conclusion-heading-icon {
    flex: none;
    width: 1.25em;
    height: 1.25em;
    color: var(--color-accent);
  }

  .conclusion-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .conclusion-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.55rem;
    margin: 0 0 0.65rem;
    line-height: 1.75;
  }

  .conclusion-list li:last-child {
    margin-bottom: 0;
  }

  .conclusion-item-icon {
    flex: none;
    width: 1em;
    height: 1em;
    /* 行の1文字目と高さを揃える。line-height 1.75 の中央あたりに置く */
    margin-top: 0.42em;
    color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .conclusion-box {
      padding: 1.25rem 1.1rem;
      margin-bottom: 2rem;
    }

    .conclusion-heading {
      font-size: 1rem;
    }

    .conclusion-list li {
      font-size: 0.95rem;
    }
  }
</style>

  specs: [
    { label: '価格', value: '7,800円（税込・公式サイト記載価格）' },
    { label: '内容量', value: '60mL' },
    { label: '1本の使用日数', value: '30日分' },
    { label: 'ミノキシジル以外の有効成分', value: '3種' },
    { label: '容器', value: '頭皮に押し込んで使うクッションラバーヘッド' },

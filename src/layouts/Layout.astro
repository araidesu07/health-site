---
/**
 * サイト共通レイアウト。
 * 記事ページ・トップページ・固定ページは、すべてこれを使う。
 *
 * ここに入っているもの：
 *   - HTMLの外枠（<html> / <head> / <body>）
 *   - 共通ヘッダー（サイト名 → トップへのリンク）
 *   - 共通フッター（固定ページへのリンク、著作権表記）
 *   - global.css の読み込み
 *
 * ページ固有の <head> 要素（記事のJSON-LDなど）は、
 * 呼び出し側から slot="head" で差し込む。
 */
import '../styles/global.css';
import { SITE_NAME, FOOTER_LINKS, THUMBNAIL_SIZE, isNoindexPath } from '../consts';

interface Props {
  /** <title> と検索結果に出る見出し */
  title: string;
  /** meta description。省略可 */
  description?: string;
  /** OGP 画像（サイト内パス）。指定したページだけ OGP / Twitter Card を出す */
  image?: string;
}

const { title, description, image } = Astro.props;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

/* SNS は相対URLを解釈しないため、画像は絶対URLにする */
const imageURL = image && Astro.site ? new URL(image, Astro.site).href : undefined;

/* 試作・プレビューは検索に載せない（対象は consts.ts の isNoindexPath） */
const noindex = isNoindexPath(Astro.url.pathname);

const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonicalURL && <link rel="canonical" href={canonicalURL} />}
    {noindex && <meta name="robots" content="noindex" />}

    {imageURL && (
      <>
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:title" content={title} />
        {description && <meta property="og:description" content={description} />}
        {canonicalURL && <meta property="og:url" content={canonicalURL} />}
        <meta property="og:image" content={imageURL} />
        <meta property="og:image:width" content={String(THUMBNAIL_SIZE.width)} />
        <meta property="og:image:height" content={String(THUMBNAIL_SIZE.height)} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={imageURL} />
      </>
    )}

    <slot name="head" />
  </head>

  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/">{SITE_NAME}</a>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <nav class="footer-nav">
          {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
        <p class="copyright">© {year} {SITE_NAME}</p>
      </div>
    </footer>
  </body>
</html>

---
/**
 * 商品ごとの独立章（schema v3 / v4）
 *
 * 商品詳細をカードグリッドで横並びにせず、1商品＝1つの全幅セクションとして縦に並べる。
 *
 * v3（既存記事）
 *   商品名（h2）／商品画像／direction（誰に向くか）／この商品を選んだ理由（directReason）
 *   ／この商品の特徴（overview）／主要スペック（supportingFacts）／買う前に確認したいこと
 *
 * v4（共通形式）
 *   商品名（h2）＋メーカー／商品画像＋CTA／この商品の特徴（overview）
 *   ／主要スペック（price / volume / supportingFacts）／買う前に確認したいこと／CTA
 *
 *   メーカーが公式に説明している特徴は overview に溶かし込む。
 *   「メーカーが訴求しているポイント」のような内部分類名を読者向け見出しにしない。
 *
 *   v4 では紹介商品同士の評価・推薦を作らないため、direction と directReason を描画しない。
 *   「メーカーが訴求している」ことと「この記事が薦める」ことを混同しない。
 *
 * 固定のブロック構成を強制しない。**値の無い項目はブロックごと描画しない**。
 * 商品ごとの項目数・文章量は揃えない。
 * productId は内部参照用であり、ここでは一切描画しない。
 */
import { toLargeImage } from './ProductCard.astro';
import type { Product } from './ProductCard.astro';
import AffiliateCTA from './AffiliateCTA.astro';
import InlineText from './InlineText.astro';

interface Props extends Product {
  /** CTAの文言。煽り文言にしないこと */
  ctaLabel?: string;
  /** 目次から参照するための通し番号（1始まり） */
  index?: number;
  /** schema v4 の描画にするか。ArticleLayout が渡す。既定は v3 描画 */
  v4?: boolean;
}

const {
  name,
  image,
  url,
  affiliateUrl,
  affiliateLabel,
  affiliateProvider,
  direction,
  overview = [],
  supportingFacts = [],
  buyBeforeNotes = [],
  directReason,
  ctaLabel,
  trackingPixel,
  index,
  v4 = false,
  maker,
  price,
  volume,
  keyPoint,
} = Astro.props;

/**
 * ASP から提供された画像URLは加工しない（短縮・再生成・サイズ書き換えをしない）。
 * legacy の記事だけ、従来どおり 300x300 への正規化を通す。
 */
const isV3Media = typeof affiliateUrl === 'string' && affiliateUrl.trim() !== '';
const imageSrc = isV3Media ? image : toLargeImage(image);

const anchorId = typeof index === 'number' ? `product-${index}` : undefined;
const pixel = typeof trackingPixel === 'string' && trackingPixel.trim() !== ''
  ? trackingPixel.trim()
  : undefined;

// 購入導線は affiliateUrl が正。legacy の url しか無い記事のためにフォールバックを残す
const buyUrl = (affiliateUrl ?? url ?? '').trim() || undefined;
// 煽らない既定文言。affiliateLabel があればそれを使う
const buyLabel = (affiliateLabel ?? ctaLabel ?? '').trim() || 'この商品をチェック';

const clean = (list?: string[]) =>
  Array.isArray(list) ? list.filter((t) => typeof t === 'string' && t.trim() !== '') : [];

const overviewText = clean(overview);
const specs = clean(supportingFacts);
const beforeNotes = clean(buyBeforeNotes);
// v4 は紹介商品同士の推薦を作らないため、direction / directReason を読まない
const reason = !v4 && typeof directReason === 'string' ? directReason.trim() : '';
const forWhom = !v4 && typeof direction === 'string' ? direction.trim() : '';

/* v4：価格・内容量は専用キーが正。主要スペックの先頭に並べる */
const makerName = typeof maker === 'string' ? maker.trim() : '';
const specHead = v4
  ? [
      ...(typeof price === 'string' && price.trim() !== '' ? [`価格：${price.trim()}`] : []),
      ...(typeof volume === 'string' && volume.trim() !== '' ? [`内容量：${volume.trim()}`] : []),
    ]
  : [];
const specLines = [...specHead, ...specs];
// 見出しは v3・v4 で共通。内部分類名を読者向けの見出しにしない
const specLabel = '主要スペック';

/* v4：「ラベル：値」で書かれたスペック行を2列に分ける。
   カテゴリ固有のラベル名は持たない。分けられない行は値だけの1行として扱う */
const SPEC_SEPARATOR = /[：:]/;
const specRows = v4
  ? specLines.map((line) => {
      const at = line.search(SPEC_SEPARATOR);
      return at > 0
        ? { label: line.slice(0, at).trim(), value: line.slice(at + 1).trim() }
        : { label: '', value: line.trim() };
    })
  : [];
---

<section class="product-section" id={anchorId} data-schema={v4 ? 'v4' : 'v3'}>
  {/* v4：画像・メーカー・商品名・価格・一言特徴を1つのヘッダーにまとめ、
       特徴 → 主要スペック → CTA までを1枚のカードとして続けて読ませる */}
  {v4 ? (
    <div class="product-section-card-head">
      {imageSrc && (
        <div class="product-section-thumb">
          <img src={imageSrc} alt={name} loading="lazy" decoding="async" />
        </div>
      )}
      <div class="product-section-head-text">
        {makerName && <p class="product-section-maker">{makerName}</p>}
        <h2 class="product-section-name">{name}</h2>
        {typeof price === 'string' && price.trim() !== '' && (
          <p class="product-section-price">{price.trim()}</p>
        )}
        {typeof keyPoint === 'string' && keyPoint.trim() !== '' && (
          <p class="product-section-chip">{keyPoint.trim()}</p>
        )}
      </div>
    </div>
  ) : (
    <h2 class="product-section-name">{name}</h2>
  )}

  {/* v3（公開中の記事）の描画は変えない */}
  {!v4 && (imageSrc || buyUrl) && (
    <div class="product-section-head" data-schema="v3">
      {imageSrc && (
      <div class="product-section-image">
        {buyUrl ? (
          <a href={buyUrl} target="_blank" rel="nofollow sponsored noopener noreferrer">
            <img src={imageSrc} alt={name} loading="lazy" decoding="async" />
          </a>
        ) : (
          <img src={imageSrc} alt={name} loading="lazy" decoding="async" />
        )}
      </div>
      )}

      {buyUrl && (
        <p class="product-section-head-cta">
          <a
            class="product-section-cta"
            href={buyUrl}
            target="_blank"
            rel="nofollow sponsored noopener"
          >
            {buyLabel}
          </a>
        </p>
      )}
    </div>
  )}

  {/* 誰に向くかは direction の文言自体が語る。表示層で見出しを足さない */}
  {forWhom && (
    <div class="product-section-block product-section-for">
      <p class="product-section-tag">{forWhom}</p>
    </div>
  )}

  {/* 「なぜ自分に向くのか」を最初に読ませる。特徴・スペックより前に置く */}
  {reason && (
    <div class="product-section-block product-section-reason">
      <h3 class="product-section-label">この商品を選んだ理由</h3>
      <p class="product-section-text"><InlineText text={reason} /></p>
    </div>
  )}

  {overviewText.length > 0 && (
    <div class="product-section-block">
      <h3 class="product-section-label">この商品の特徴</h3>
      {overviewText.map((line) => <p class="product-section-text"><InlineText text={line} /></p>)}
    </div>
  )}

  {specLines.length > 0 && (
    <div class="product-section-block">
      <h3 class="product-section-label">{specLabel}</h3>
      {v4 ? (
        /* 「ラベル：値」で書かれた行は2列に分けて読みやすくする。
           区切りの無い行はそのまま1行として出す（記事側の文を変えない） */
        <dl class="product-section-spec-list">
          {specRows.map((row) => (
            <div class="product-section-spec-row" data-split={row.label ? 'on' : 'off'}>
              {row.label && <dt>{row.label}</dt>}
              <dd><InlineText text={row.value} /></dd>
            </div>
          ))}
        </dl>
      ) : (
        <ul class="product-section-specs">
          {specLines.map((line) => <li><InlineText text={line} /></li>)}
        </ul>
      )}
    </div>
  )}

  {/* writer が渡したときだけ出す。固定ブロックにはしない */}
  {beforeNotes.length > 0 && (
    <div class="product-section-block">
      <h3 class="product-section-label">買う前に確認したいこと</h3>
      <ul class="product-section-specs">
        {beforeNotes.map((line) => <li><InlineText text={line} /></li>)}
      </ul>
    </div>
  )}

  {/* 画像だけが購入導線にならないよう、説明を読んだ直後に必ず明示的なCTAを置く。
      v4 は共通の AffiliateCTA を使う。v3（公開中の記事）の描画は変えない */}
  {buyUrl && v4 && (
    <p class="product-section-cta-wrap">
      <AffiliateCTA
        url={buyUrl}
        label={buyLabel}
        provider={affiliateProvider}
        variant="full"
        ariaLabel={`${name}｜${buyLabel}（外部サイト）`}
      />
    </p>
  )}

  {buyUrl && !v4 && (
    <p class="product-section-cta-wrap">
      <a
        class="product-section-cta"
        href={buyUrl}
        target="_blank"
        rel="nofollow sponsored noopener"
      >
        {buyLabel}
      </a>
    </p>
  )}

  {/* ASP の計測用ピクセル。提供コードと同じく 1×1 で出力する */}
  {pixel && (
    <img class="product-section-pixel" src={pixel} width="1" height="1" alt="" aria-hidden="true" />
  )}
</section>

<style>
  .product-section {
    margin: 0 0 3rem;
  }

  .product-section-name {
    margin: 0 0 1rem;
  }

  /* v4：商品名の下に置くメーカー名 */
  .product-section-maker {
    margin: -0.6rem 0 1rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  /* =========================================================
     v4：商品詳細を1枚のカードにまとめる。
     画像・特徴・主要スペック・CTA が続けて読める単位になることを狙う。
     v3（公開中の記事）には一切かからないよう [data-schema='v4'] で閉じる
     ========================================================= */
  .product-section[data-schema='v4'] {
    margin: 0 0 3.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .product-section-card-head {
    display: flex;
    gap: 1.1rem;
    padding: 1.4rem 1.5rem;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .product-section-thumb {
    display: grid;
    place-items: center;
    flex: none;
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--radius-md);
    background: var(--color-bg-subtle);
  }

  .product-section-thumb img {
    max-height: 5.5rem;
    width: auto;
    mix-blend-mode: multiply;
  }

  .product-section[data-schema='v4'] .product-section-maker {
    margin: 0 0 0.15rem;
    font-size: 0.78rem;
    color: var(--color-text-faint);
  }

  .product-section[data-schema='v4'] .product-section-name {
    margin: 0 0 0.5rem;
    font-size: 1.16rem;
    font-weight: 800;
    line-height: 1.55;
    color: var(--color-primary-dark);
  }

  .product-section-price {
    margin: 0 0 0.6rem;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1.5;
    color: var(--color-text);
  }

  .product-section-chip {
    display: inline-block;
    margin: 0;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-sand);
    border-radius: var(--radius-sm);
    background: var(--color-sand-light);
    font-size: 0.82rem;
    font-weight: 600;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* カードの内側に共通の余白を与える。ブロックごとの罫線は引かない */
  .product-section[data-schema='v4'] .product-section-block {
    padding: 1.4rem 1.5rem 0;
  }

  .product-section[data-schema='v4'] .product-section-label {
    margin: 0 0 0.85rem;
    padding: 0;
    border-left: 0;
    color: var(--color-primary);
    font-size: 0.86rem;
    font-weight: 800;
    letter-spacing: 0.04em;
  }

  .product-section-spec-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-soft);
  }

  .product-section-spec-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 0.6rem;
    padding: 0.7rem 0.2rem;
    border-bottom: 1px solid var(--color-border-soft);
  }

  .product-section-spec-row[data-split='off'] {
    grid-template-columns: 1fr;
  }

  .product-section-spec-row dt {
    color: var(--color-text-muted);
    font-size: 0.82rem;
    font-weight: 700;
    line-height: 1.75;
  }

  .product-section-spec-row dd {
    margin: 0;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.75;
  }

  .product-section[data-schema='v4'] .product-section-cta-wrap {
    margin: 0;
    padding: 1.4rem 1.5rem 1.5rem;
  }

  @media (max-width: 560px) {
    .product-section-card-head {
      flex-direction: column;
      padding: 1.2rem 1.15rem;
    }

    .product-section-thumb {
      width: 5.5rem;
      height: 5.5rem;
    }

    .product-section[data-schema='v4'] .product-section-block {
      padding: 1.2rem 1.15rem 0;
    }

    .product-section[data-schema='v4'] .product-section-cta-wrap {
      padding: 1.2rem 1.15rem 1.2rem;
    }

    .product-section-spec-row {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  /* 画像（左）と購入導線（右）。狭い画面では縦積みにする */
  .product-section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin: 0 0 1.5rem;
  }

  .product-section-image {
    flex: none;
  }

  /* ASP の 128x128 素材を、それ以上に引き伸ばさない */
  .product-section-image img {
    display: block;
    width: auto;
    max-width: min(128px, 100%);
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
  }

  /* v4：商品名・メーカーのすぐ下に置く商品画像。枠線は付けず、白背景の商品画像でも
     輪郭が消えないよう淡い下地と余白だけ持たせる。128px 素材を極端に拡大しない */
  .product-section-head[data-schema="v4"] .product-section-image img {
    width: 160px;
    max-width: 100%;
    height: 160px;
    padding: 8px;
    border: 0;
    border-radius: 8px;
    background: var(--color-bg-subtle);
    object-fit: contain;
  }

  @media (max-width: 480px) {
    .product-section-head[data-schema="v4"] .product-section-image img {
      width: 132px;
      height: 132px;
    }
  }

  .product-section-head-cta {
    margin: 0;
  }

  .product-section-block {
    margin: 0 0 1.35rem;
  }

  .product-section-block:last-of-type {
    margin-bottom: 0;
  }

  .product-section-label {
    margin: 0 0 0.4rem;
    font-size: 0.98rem;
    font-weight: 700;
    line-height: 1.6;
    color: var(--color-primary-dark);
  }

  .product-section-text {
    margin: 0 0 0.6rem;
    line-height: 1.9;
  }

  .product-section-text:last-child {
    margin-bottom: 0;
  }

  .product-section-tag {
    display: inline-block;
    margin: 0;
    padding: 0.28rem 0.8rem;
    border-radius: 999px;
    background: var(--color-primary-light);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  /* 主要スペックは拾い読みできるように、余白を詰めた定義的な見せ方にする */
  .product-section-specs {
    margin: 0;
    padding: 0.9rem 1.1rem;
    border-radius: 6px;
    background: var(--color-bg-subtle);
    list-style: none;
  }

  .product-section-specs li {
    margin: 0 0 0.4rem;
    padding-left: 1rem;
    position: relative;
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .product-section-specs li:last-child {
    margin-bottom: 0;
  }

  .product-section-specs li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .product-section-reason .product-section-label {
    color: var(--color-accent);
  }

  .product-section-cta-wrap {
    margin: 1.5rem 0 0;
  }

  .product-section-cta {
    display: inline-block;
    padding: 0.7rem 1.6rem;
    border-radius: 6px;
    background: var(--color-primary);
    color: #ffffff;
    font-weight: 700;
    text-decoration: none;
  }

  .product-section-cta:hover {
    background: var(--color-primary-dark);
  }

  .product-section-pixel {
    position: absolute;
    width: 1px;
    height: 1px;
    border: 0;
  }

  /* アンカーで飛んだとき見出しが上端に貼り付かないようにする */
  .product-section {
    scroll-margin-top: 1.5rem;
  }
</style>

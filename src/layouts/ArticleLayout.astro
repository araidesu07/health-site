---
/**
 * 記事(.md)用のレイアウト。
 * HTMLの外枠・ヘッダー・フッターは Layout.astro が持っている。
 * ここは記事固有の要素だけを担当する。
 *   - 記事タイトル(h1)
 *   - 広告表記（frontmatter の affiliate: true のときだけ）
 *   - 著者・公開日・更新日
 *   - JSON-LD
 *   - 結論ボックス（frontmatter の conclusion があるときだけ）
 *   - カテゴリ検討（frontmatter の categoryDecision があるときだけ）
 *   - 選び方の軸（frontmatter の decisionAxes があるときだけ）
 *   - タイプ別早見表（frontmatter の typeGuide があるときだけ）
 *   - 商品カード（frontmatter の products があるときだけ）
 *
 * 本文より前に置くブロックは、対応する frontmatter キーが無ければ何も描画しない。
 * したがって既存記事の表示は変わらない。
 */
import Layout from './Layout.astro';
import ConclusionBox from '../components/ConclusionBox.astro';
import CategoryDecision from '../components/CategoryDecision.astro';
import DecisionAxes from '../components/DecisionAxes.astro';
import TypeGuide from '../components/TypeGuide.astro';
import ProductCardGrid from '../components/ProductCardGrid.astro';
import IssueOneSection from '../components/IssueOneSection.astro';
import RecommendationSummary from '../components/RecommendationSummary.astro';
import ProductSection from '../components/ProductSection.astro';
import TableOfContents from '../components/TableOfContents.astro';
import SourceList from '../components/SourceList.astro';
import PurchaseNotes from '../components/PurchaseNotes.astro';
import type { Product } from '../components/ProductCard.astro';
import type { IssueOneData } from '../components/IssueOneSection.astro';
import type { IssueOneVisualData } from '../components/IssueOneVisual.astro';
import type { Source } from '../components/SourceList.astro';
import type { TypeGuideItem } from '../components/TypeGuide.astro';
import type { CategoryDecisionData } from '../components/CategoryDecision.astro';
import type { DecisionAxisItem } from '../components/DecisionAxes.astro';
import { SITE_NAME } from '../consts';
import InlineText from '../components/InlineText.astro';

const { frontmatter } = Astro.props;

const DEFAULT_AUTHOR = 'トウノ';

/** frontmatterの日付を "YYYY-MM-DD" に揃える（YAMLがDate型で渡す場合にも対応） */
function toISODate(value: unknown): string | undefined {
  if (!value) return undefined;
  const text = value instanceof Date
    ? value.toISOString().slice(0, 10)
    : String(value).slice(0, 10);
  return /^\d{4}-\d{2}-\d{2}$/.test(text) ? text : undefined;
}

/** "2026-08-24" → "2026年8月24日" */
function formatJa(iso: string): string {
  const [year, month, day] = iso.split('-').map(Number);
  return `${year}年${month}月${day}日`;
}

const title = frontmatter.title ?? '記事';
const description = frontmatter.description;
const author = frontmatter.author ?? DEFAULT_AUTHOR;
const isAffiliate = frontmatter.affiliate === true;

/* v2 の記事順序に沿って、本文の前に置く構成要素。
   結論 → カテゴリ検討 → 選び方の軸 → 候補絞り込み → 主要商品 の順に並べる。
   frontmatter に無い既存記事では undefined になり、何も描画されない。 */
const conclusion: string[] | undefined = frontmatter.conclusion;
const categoryDecision: CategoryDecisionData | undefined = frontmatter.categoryDecision;
const decisionAxes: DecisionAxisItem[] | undefined = frontmatter.decisionAxes;
const typeGuide: TypeGuideItem[] | undefined = frontmatter.typeGuide;
const typeGuideNote: string | undefined = frontmatter.typeGuideNote;
const products: Product[] | undefined = frontmatter.products;

/* --- schema v3 --- */
// schemaVersion 3 以上で構造化描画。キーが無い既存記事は legacy 描画のまま
const schemaVersion = Number(frontmatter.schemaVersion);
const isV3 = schemaVersion >= 3;
// v4：推薦（direction / directReason）を持たない共通フォーマット。v3 記事の描画は変えない
const isV4 = schemaVersion >= 4;
const issueOne: IssueOneData | undefined = frontmatter.issueOne;
const sources: Source[] | undefined = frontmatter.sources;
/* 記事全体の価格条件を補足する注記。出典の直前に1回だけ置く。
   比較表の直下にも短い注記があるが、あちらはその場で価格差を誤解させないためのもので役割が違う */
const priceNote: string | undefined =
  typeof frontmatter.priceNote === 'string' && frontmatter.priceNote.trim() !== ''
    ? frontmatter.priceNote.trim()
    : undefined;
// v3 の conclusion はマップ（issue1）。推薦一覧は products[] から生成する（SSoT）
const conclusionIssue1: string | undefined =
  isV3 && conclusion && !Array.isArray(conclusion)
    ? (conclusion as unknown as { issue1?: string }).issue1
    : undefined;
/* v3 は「こんな人向け（direction）」付き。v4 は推薦を作らないので direction を渡さない。
   結論では「この記事で紹介する商品」を並べるだけにする */
/* v4：結論ボックスに置く視覚表現（conclusion.visual）。形式は issueOne.blocks[].visual と同じ。
   商品一覧より先に「この記事で何を基準に絞れるか」を見せたい記事だけが指定する */
const conclusionMap =
  isV4 && conclusion && !Array.isArray(conclusion)
    ? (conclusion as unknown as { visual?: IssueOneVisualData; showProducts?: boolean })
    : undefined;
const conclusionVisual: IssueOneVisualData | undefined = conclusionMap?.visual;
/* v4：conclusion.showProducts: false のときだけ、結論ボックスの商品一覧を出さない。
   未指定の記事（既存記事すべて）は従来どおり一覧を出す */
const showConclusionProducts = conclusionMap?.showProducts !== false;
const conclusionRecommendations = isV3 && showConclusionProducts && Array.isArray(products)
  ? products.map((p) => ({
      ...(isV4 ? {} : { direction: p.direction }),
      name: p.name,
      keyPoint: p.keyPoint,
      /* v4：商品を決めた読者をここで拾う。導線は結論の一覧と商品詳細の2か所だけ。
         計測用ピクセルは商品ごとに1回なので、ここでは渡さない（ProductSection が描画する） */
      ...(isV4
        ? {
            affiliateUrl: p.affiliateUrl,
            affiliateLabel: p.affiliateLabel,
            affiliateProvider: p.affiliateProvider,
          }
        : {}),
    }))
  : [];

/* v4：購入・使用前の注意。商品詳細のあと・出典の前に1回だけ置く。
   ① の中で安全情報を展開せず、ここへ集約するためのキー */
const purchaseNotes: string[] | undefined =
  isV4 && Array.isArray(frontmatter.purchaseNotes) ? frontmatter.purchaseNotes : undefined;

/* v4：比較表の前に置く短い前置き。何が共通で、どこに違いが出るのかを記事側が書く */
const comparisonLead: string | undefined =
  isV4 && typeof frontmatter.comparisonLead === 'string' && frontmatter.comparisonLead.trim() !== ''
    ? frontmatter.comparisonLead.trim()
    : undefined;

/* v4：比較表の見出し。未指定なら既定（「N商品の違いを比較」）。目次の文言も同じ値にそろえる */
const comparisonHeading: string | undefined =
  isV4 && typeof frontmatter.comparisonHeading === 'string' && frontmatter.comparisonHeading.trim() !== ''
    ? frontmatter.comparisonHeading.trim()
    : undefined;

const datePublished = toISODate(frontmatter.datePublished);
const dateModified = toISODate(frontmatter.dateModified) ?? datePublished;
const showModified = dateModified !== undefined && dateModified !== datePublished;

const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  ...(description ? { description } : {}),
  ...(datePublished ? { datePublished } : {}),
  ...(dateModified ? { dateModified } : {}),
  author: { '@type': 'Person', name: author },
  publisher: { '@type': 'Organization', name: SITE_NAME },
  ...(canonicalURL ? { mainEntityOfPage: canonicalURL } : {}),
};
---

<Layout title={title} description={description}>
  <script
    type="application/ld+json"
    is:inline
    slot="head"
    set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
  />

  <article>
    <h1>{title}</h1>

    {isAffiliate && (
      <p class="affiliate-notice">本記事はプロモーションを含みます。</p>
    )}

    <p class="article-meta">
      <span class="author">著者：{author}</span>
      {datePublished && (
        <span>
          公開日：<time datetime={datePublished}>{formatJa(datePublished)}</time>
        </span>
      )}
      {showModified && dateModified && (
        <span>
          更新日：<time datetime={dateModified}>{formatJa(dateModified)}</time>
        </span>
      )}
    </p>

    {isV3 ? (
      <>
        <ConclusionBox
          issue1={conclusionIssue1}
          recommendations={conclusionRecommendations}
          visual={conclusionVisual}
        />

        <TableOfContents issueOne={issueOne} issueOneTitle={issueOne?.title} products={products} summaryHeading={comparisonHeading} v4={isV4} />

        <IssueOneSection data={issueOne} />

        <RecommendationSummary items={products} lead={comparisonLead} heading={comparisonHeading} v4={isV4} />

        {/* v3/v4 とも商品ごとに全幅の独立章。カードグリッドで横並びにしない */}
        {(products ?? []).map((product, i) => (
          <ProductSection {...product} index={i + 1} v4={isV4} />
        ))}

        {/* v4：安全情報は本文で展開せず、ここに最小限だけ集約する */}
        <PurchaseNotes items={purchaseNotes} />

        {priceNote && <p class="article-price-note"><InlineText text={priceNote} /></p>}

        <SourceList items={sources} />

        <slot />
      </>
    ) : (
      <>
        <ConclusionBox items={conclusion} />

        <CategoryDecision data={categoryDecision} />

        <DecisionAxes items={decisionAxes} />

        <TypeGuide items={typeGuide} note={typeGuideNote} />

        <ProductCardGrid items={products} />

        <slot />
      </>
    )}
  </article>
</Layout>

<style>
  /* 注釈。本文より小さく、控えめな色で置く */
  .article-price-note {
    margin: 2.5rem 0 0;
    font-size: 0.78rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }
</style>

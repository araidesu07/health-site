---
/**
 * 目次（schema v3）
 *
 * frontmatter に toc 専用の配列は持たない。既存の SSoT から生成する。
 *   issueOne.title            → #issue-one
 *   「おすすめ商品をざっくり比較」 → #recommendations
 *   products[].name           → #product-1 / #product-2 / ...
 *
 * #issue-one は、IssueOneSection が実際に描画されるときだけ出す（死んだアンカーを作らない）。
 * 判定は IssueOneSection.astro の hasIssueOneContent() を共有する。
 *
 * productId はアンカーにも本文にも露出させない。
 * 結論より目立たせない。固定追従にしない。
 */
import type { Product } from './ProductCard.astro';
import { hasIssueOneContent } from './IssueOneSection.astro';
import type { IssueOneData } from './IssueOneSection.astro';

interface Props {
  /** Issue 1 セクションの見出し（issueOne.title） */
  issueOneTitle?: string;
  /**
   * 記事 frontmatter の issueOne。
   * 渡された場合は IssueOneSection と同じ条件で #issue-one の有無を決める。
   * 渡されない場合は issueOneTitle の有無だけで判定する（従来どおり）。
   */
  issueOne?: IssueOneData;
  /** 記事 frontmatter の products */
  products?: Product[];
  /** ざっくり比較の見出し。RecommendationSummary と揃える */
  summaryHeading?: string;
  /** 見出し文言。通常は変えない */
  heading?: string;
  /** schema v4 か。見出し文言を RecommendationSummary と揃えるために使う */
  v4?: boolean;
}

const {
  issueOneTitle,
  issueOne,
  products = [],
  summaryHeading: summaryHeadingProp,
  heading = '目次',
  v4 = false,
} = Astro.props;

const productItems = Array.isArray(products)
  ? products.filter((p) => p && typeof p.name === 'string' && p.name.trim() !== '')
  : [];

// v4 は「おすすめ」と言わない（RecommendationSummary の既定と同じ文言・同じ件数にする）
const summaryHeading =
  summaryHeadingProp ??
  (v4 ? `${productItems.length}商品の違いを比較` : 'おすすめ商品をざっくり比較');

const items: { href: string; label: string }[] = [];

// 見出しは issueOne.title（validator が v3 で必須にしている）
const issueOneLabel = (issueOne?.title ?? issueOneTitle ?? '').trim();
// issueOne が渡されていれば IssueOneSection と同じ判定。無ければ従来どおり見出しの有無で判定する
const showIssueOne =
  issueOneLabel !== '' && (issueOne === undefined || hasIssueOneContent(issueOne));

if (showIssueOne) {
  items.push({ href: '#issue-one', label: issueOneLabel });
}

if (productItems.length > 0) {
  items.push({ href: '#recommendations', label: summaryHeading });
  productItems.forEach((product, i) => {
    items.push({ href: `#product-${i + 1}`, label: product.name });
  });
}

const hasItems = items.length > 0;
---

{hasItems && (
  <nav class="toc" aria-label={heading}>
    <p class="toc-heading">{heading}</p>
    <ol class="toc-list">
      {items.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  /* 結論ボックスより目立たせない。控えめな枠だけを持たせる */
  .toc {
    margin: 0 0 2.5rem;
    padding: 1.1rem 1.35rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    background: var(--color-bg);
  }

  .toc-heading {
    margin: 0 0 0.6rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-muted);
  }

  .toc-list {
    margin: 0;
    padding-left: 1.4rem;
  }

  .toc-list li {
    margin: 0 0 0.4rem;
    line-height: 1.7;
  }

  .toc-list li:last-child {
    margin-bottom: 0;
  }

  .toc-list a {
    color: var(--color-primary);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .toc-list a:hover {
    text-decoration: underline;
  }
</style>
